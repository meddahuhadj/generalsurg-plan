# Variables pour docker-compose.yml (stack complet : caddy + backend + postgres + orthanc)
# Copiez ce fichier en .env à la racine du dépôt et renseignez de vraies valeurs.
# Sans ce fichier, `docker compose up` refuse de démarrer (voir les
# ${VAR:?...} dans docker-compose.yml) plutôt que de retomber sur des valeurs
# par défaut codées en dur et versionnées.

# Nom de domaine pointant déjà (DNS A/AAAA) vers l'IP de ce serveur — Caddy
# obtient et renouvelle seul son certificat Let's Encrypt pour ce domaine.
DOMAIN=ophtalmosurg.mondomaine.example

# Email de contact pour Let's Encrypt (alertes d'expiration de certificat).
# Optionnel mais recommandé.
ACME_EMAIL=admin@mondomaine.example

# Générer une valeur forte, par ex. : openssl rand -hex 24
POSTGRES_PASSWORD=changez-moi-avec-une-longue-chaine-aleatoire-en-production

# Générer une valeur forte, par ex. : openssl rand -hex 32
# Sans cette variable, backend/main.py refuse de démarrer en APP_ENV=production
# (voir le garde-fou anti-mauvaise-config) : un secret manquant génèrerait un
# secret aléatoire DIFFÉRENT par worker Uvicorn, cassant l'authentification de
# façon intermittente entre les 4 workers du Dockerfile.
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire-en-production
