# ORLSurgPlan3D — variables d'environnement serveur
# Les clés API et secrets sont stockés UNIQUEMENT ici — JAMAIS dans le code client.
# Copiez ce fichier en .env et remplissez les valeurs réelles.

# --- Environnement ---
# "development" (défaut) : rien n'est bloqué, pratique pour développer/tester.
# "production" : le serveur REFUSE de démarrer si JWT_SECRET est resté à sa
# valeur par défaut et/ou si SEED_DEMO_USERS=true (comptes dr.hadj/dr.benali,
# mot de passe "changeme", public dans ce dépôt). C'est le garde-fou avant un
# vrai déploiement clinique — ne l'oubliez pas au moment de la mise en prod.
APP_ENV=development

# --- IA ---
GEMINI_KEY=AIzaSy...
GROQ_KEY=gsk_...
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=llama-3.3-70b-versatile

# --- Authentification ---
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire-en-production
JWT_TTL_MIN=480
TOTP_ISSUER=ORLSurgPlan3D

# --- Base de données ---
# Par défaut (non défini) : SQLite local ./orlsurgplan3d.db (zero-config, dev uniquement).
# Production : PostgreSQL, ex. via `docker compose up -d db` (voir docker-compose.yml) :
DATABASE_URL=postgresql+psycopg2://orlsurgplan3d:orlsurgplan3d@localhost:5432/orlsurgplan3d

# --- Segmentation IA réelle (TotalSegmentator) — voir requirements-segmentation.txt ---
# Dossier où sont écrits les maillages .glb générés (servis sous /meshes/...)
MESH_STORAGE_DIR=./storage/meshes

# --- PACS / DICOMweb (QIDO-RS + WADO-RS) — voir backend/pacs_client.py ---
# URL de base QIDO-RS/WADO-RS de votre PACS (Orthanc, dcm4chee, dicoogle...).
# Ex. Orthanc : http://pacs.hopital.local:8042/dicom-web
# Si non renseigné ici, le frontend peut passer qido_url/wado_url à chaque appel.
PACS_QIDO_URL=
PACS_WADO_URL=
# Authentification PACS : soit Basic Auth (user/password), soit Bearer token.
PACS_AUTH_USER=
PACS_AUTH_PASSWORD=
PACS_AUTH_TOKEN=
# "false" uniquement pour un PACS intra-hospitalier avec certificat auto-signé.
PACS_VERIFY_SSL=true
# Timeout réseau par appel PACS, en secondes (échec rapide + disjoncteur plutôt
# qu'une longue attente ; voir backend/resilience.py).
PACS_TIMEOUT_SECONDS=15
# "true" pour autoriser le frontend à passer qido_url/wado_url à chaque appel
# (utile pour tester un PACS différent sans redéployer). ATTENTION : un
# utilisateur authentifié quelconque pourrait alors faire pointer ce serveur
# vers une URL de son choix (SSRF). Les identifiants réels (PACS_AUTH_*)
# ne sont de toute façon jamais envoyés à une URL différente de celle
# configurée ci-dessus, et les cibles réseau dangereuses (loopback,
# lien-local/métadonnées cloud) restent bloquées même si "true".
PACS_ALLOW_CLIENT_URL_OVERRIDE=false

# --- PACS DIMSE classique (C-FIND/C-GET) — pour un PACS n'exposant pas DICOMweb ---
# Voir backend/pacs_dimse.py. Port DICOM standard : 104 (ou 11112 en pratique
# courante, 104 nécessitant des privilèges root sur la plupart des OS).
PACS_DIMSE_HOST=
PACS_DIMSE_PORT=104
PACS_DIMSE_CALLED_AE=ANY-SCP
PACS_DIMSE_CALLING_AE=GENSURGPLAN
PACS_DIMSE_TIMEOUT=15

# --- Transport MLLP pour l'envoi réel des messages HL7 v2 (ADT/ORM/ORU) ---
# Voir backend/mllp_client.py. Port MLLP courant : 2575 (convention, pas de
# port IANA officiel réservé).
HL7_MLLP_HOST=
HL7_MLLP_PORT=2575
HL7_MLLP_TIMEOUT=10

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500

# --- Démarrage ---
# Crée automatiquement dr.hadj / dr.benali (mdp: changeme) si la base est vide.
# À mettre sur "false" avant toute mise en production.
SEED_DEMO_USERS=true

# --- Comptes (déploiement pilote réel) ---
# Alternative à SEED_DEMO_USERS pour créer un VRAI premier compte admin (mot
# de passe choisi par vous, pas "changeme") si la base est vide au démarrage.
# PRIORITÉ : si ces 2 variables sont définies, elles l'emportent TOUJOURS sur
# SEED_DEMO_USERS même si les deux sont positionnées par erreur — voir
# main.py:lifespan(). Une fois ce compte créé, provisionnez les suivants via
# POST /users (réservé au rôle admin) plutôt que de recourir à SEED_DEMO_USERS.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=

# Auto-inscription publique (POST /auth/register, toujours rôle "surgeon").
# "true" (défaut) convient à la démo publique. Pour un pilote réel, mettez
# "false" — les comptes se créent alors uniquement via POST /users (admin),
# avec le rôle explicite de votre choix.
ALLOW_SELF_REGISTRATION=true

# --- Logging ---
# "INFO" par défaut. En production, utiliser "INFO" ou "WARNING".
# En JSON structuré (ELK/Loki/Grafana), chaque requête reçoit un correlation_id.
LOG_LEVEL=INFO

# --- Stockage DICOM local ---
# Répertoire où sont stockés les fichiers DICOM uploadés et les maillages .glb.
# En production, utiliser un volume Docker persistant ou un NFS partagé.
STORAGE_DIR=./storage

# --- Rate Limiting ---
# Nombre maximum de tentatives par minute par IP sur POST /auth/token
# UNIQUEMENT (l'étape mot de passe). /auth/2fa/verify (10/min, code TOTP/
# secours) et /auth/register (5/min) ont leurs propres limites, non
# configurables via une variable d'environnement — voir backend/resilience.py.
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Services exploratoires (Jalons M21-M40) ---
# Nanorobots, BCI, cryo-BNCT, bio-impression, etc. : concepts de recherche non
# validés cliniquement, jamais des dispositifs médicaux réels. Restent chargés
# UNIQUEMENT si explicitement mis à "true" ici. NE JAMAIS activer en production
# ou sur un environnement accessible depuis un bloc opératoire.
RESEARCH_MODE=false
